# Copy to .env and fill in. All settings are read with the ORCH_ prefix (pydantic-settings).

# --- Required ---

# Single Postgres DSN, SQLAlchemy async form. The run store and workflow registry both live here.
ORCH_DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5432/orchestrator

# Airflow (first workflow engine) — REST API v2, token auth.
ORCH_AIRFLOW_BASE_URL=https://airflow.internal
ORCH_AIRFLOW_USERNAME=admin      # docker-compose Airflow standalone: fixed admin / password
ORCH_AIRFLOW_PASSWORD=password

# ServiceNow (first ticket system).
ORCH_SERVICENOW_BASE_URL=https://servicenow.internal
ORCH_SERVICENOW_USERNAME=svc-cloudio
ORCH_SERVICENOW_PASSWORD=change-me

# Project Manager (first resource manager).
ORCH_PM_BASE_URL=https://pm.internal
ORCH_PM_TOKEN=change-me

# --- Optional (defaults shown) ---

# Threshold for the stdout log sink. DEBUG/INFO/WARNING/ERROR/CRITICAL.
# The log format itself is not an env var: mount a dictConfig document at
# /opt/app/config/log-config.json for ECS JSON (see config/log-config.example.json).
# ORCH_LOG_LEVEL=INFO

# Retry policy (application-owned; expressed as WorkflowRun.scheduled_at).
# ORCH_RETRY_BASE_SECONDS=10.0

# Worker pool: each RunWorker loop claims one due run and drives it.
# ORCH_WORKER_CONCURRENCY_LIMIT=16
# ORCH_WORKER_POLL_INTERVAL_SECONDS=1.0
# ORCH_REDRIVE_LEASE_SECONDS=300.0

# team-name -> full ServiceNow assignment-group name (JSON); unknown names are used verbatim.
# ORCH_SERVICENOW_RESPONSIBLE_GROUPS={"netops": "CloudIO NetOps"}
# ORCH_SERVICENOW_INCIDENT_TEAM=cloudio

# ORCH_EXTERNAL_CALL_TIMEOUT_SECONDS=10.0
