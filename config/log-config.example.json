{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "ecs": {
      "()": "ecs_logging.StdlibFormatter",
      "exclude_fields": [
        "log.original"
      ],
      "stack_trace_limit": 25
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "ecs"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": [
      "stdout"
    ]
  },
  "loggers": {
    "uvicorn": {
      "level": "INFO",
      "handlers": [],
      "propagate": true
    },
    "uvicorn.error": {
      "level": "INFO",
      "handlers": [],
      "propagate": true
    },
    "uvicorn.access": {
      "level": "INFO",
      "handlers": [],
      "propagate": true
    },
    "httpx": {
      "level": "WARNING",
      "handlers": [],
      "propagate": true
    },
    "httpcore": {
      "level": "WARNING",
      "handlers": [],
      "propagate": true
    }
  }
}
